# Names only. Copy the relevant lines into apps/web/.env.local and apps/worker/.dev.vars
# and fill in real values there. Those files are git-ignored. Never commit secrets.

# --- apps/web/.env.local (safe to expose to the browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8787

# --- apps/worker/.dev.vars (SECRET values marked) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # SECRET
JUDGE_PROVIDER=mock               # mock | judge0
JUDGE0_API_URL=
JUDGE0_API_HOST=
JUDGE0_API_KEY=                   # SECRET
JUDGE_DAILY_LIMIT=50
ALLOWED_ORIGINS=http://localhost:5173
