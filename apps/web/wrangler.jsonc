{
  // The website: static files only, served by Cloudflare. No server code,
  // no secrets. Unknown paths (like /arena after a refresh) serve index.html.
  "name": "code-wars",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
