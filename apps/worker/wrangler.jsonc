{
  // Cloudflare Worker configuration. Secrets (SUPABASE_SERVICE_ROLE_KEY,
  // JUDGE0_API_KEY) are never stored here: use `wrangler secret put` in
  // production and .dev.vars locally.
  "name": "code-wars-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Every minute: resolve expired battles and clear stuck rows.
  "triggers": { "crons": ["* * * * *"] },
  // Production values. Local development overrides these from .dev.vars
  // (JUDGE_PROVIDER=mock there, so local testing never spends money).
  "vars": {
    "SUPABASE_URL": "https://ptrdipriebabfpfdxuim.supabase.co",
    "JUDGE_PROVIDER": "judge0",
    "JUDGE_DAILY_LIMIT": "200",
    "JUDGE0_API_URL": "https://judge0-ce.p.rapidapi.com",
    "JUDGE0_API_HOST": "judge0-ce.p.rapidapi.com",
    "ALLOWED_ORIGINS": "https://code-wars.unified-loans-commercial.workers.dev",
  },
}
